  "status": "draft: core approved by the user 2026-10-22 (clavicle + upper-arm/forearm twist); placements and ROM ranges are proposals until P5",
  "description": "Adult humanoid (hero FL, human monsters). 28 core bones + 8 sockets; aux bones come from the rig brief.",
  "conventions": {
    "units": "m",
    "blender_up": "+Z",
    "blender_front": "-Y",
    "character_left": "+X",
    "gltf_export": "+Y up, front +Z",
    "side_prefix": [
      "L_",
      "R_"
    ],
    "control_prefix": "ctl_"
  },
  "landmarks": {
    "center": [
      "pelvis",
      "spine_01",
      "spine_02",
      "chest",
      "neck",
      "head",
      "head_top"
    ],
    "sided": [
      "clavicle",
      "shoulder",
      "elbow",
      "wrist",
      "hand_tip",
      "palm",
      "hip",
      "knee",
      "ankle",
      "ball",
      "toe_tip",
      "heel_ground",
      "ball_ground",
      "toe_ground"
    ],
    "rules": {
      "pelvis": "height of the hip joint centres, on the spine line (nearer the back)",
      "spine_01": "1/3 of the spine curve from pelvis to chest",
      "spine_02": "2/3 of the spine curve from pelvis to chest",
      "chest": "armpit level, spine line nearer the back",
      "neck": "base of the neck (top of the shoulders, C7)",
      "head": "skull base, behind the ear line",
      "head_top": "top of the skull (not hair, helmet or horns)",
      "clavicle": "sternoclavicular joint: top of the sternum, just off the midline",
      "shoulder": "centre of a sphere fitted to the humeral head region (not the acromion)",
      "elbow": "between the epicondyles, slightly behind the arm mid-line; pre-bend 4-10 deg in the bend plane",
      "wrist": "midline of the wrist crease",
      "hand_tip": "end of the middle finger, or the tip of a mitten hand",
      "palm": "grip centre of the palm (weapon socket)",
      "hip": "hip joint centre inside the pelvis (medial to the outer hip bulge)",
      "knee": "on the condyle hinge behind the kneecap; keep the measured leg bend or pre-bend 4-10 deg",
      "ankle": "midpoint of the malleoli",
      "ball": "metatarsophalangeal line, slightly above the sole",
      "toe_tip": "front of the toes",
      "heel_ground": "back of the heel at z = 0",
      "ball_ground": "ball projected to z = 0",
      "toe_ground": "toe tip projected to z = 0"
    }
  },
  "priors": {
    "ankle": {
      "z_over_H": 0.039,
