  "skin": {
    "max_influences": 4,
    "prune_below": 0.01,
    "side_gate_band_H": 0.01,
    "max_influences_by_region": {
      "shoulder": 3,
      "hip": 3,
      "fingers": 2,
      "default_non_joint": 2
    },
    "profiles": {
      "shoulder": "3-way chest / {S}_Clavicle / {S}_UpperArm",
      "upper_arm": "{S}_UpperArm + {S}_UpperArm_twist re-split: a = clamp((t - t0)/(1 - t0), 0, 1), t0 = twist head position (0.25); UpperArm = m*a, twist = m*(1 - a) (references/skinning.md)",
      "elbow": "2-3 rings, 50/50 at the crease; inner crease biased to {S}_ForeArm",
      "forearm": "{S}_ForeArm + {S}_ForeArm_twist re-split: twist = m*t, ForeArm = m*(1 - t), t from elbow (0) to wrist (1); no Hand weight on the forearm",
      "hip": "pelvis / {S}_Thigh / spine_01, transition >= 10% of thigh length",
      "knee": "2-3 rings, 50/50 at the crease",
      "neck_head": "neck blends over its length; skull, helmet and jaw region to head only",
      "wrist": "hard crease band at the Hand head: hand share = clip(0.5 + u/(2h), 0, 1), h = 0.5 * wrist_rings (2) * local edge length"
    },
    "rigid_default": [
      "helmet",
      "armor plates",
      "buckles",
      "eyes",
      "horns",
      "weapons fused to the mesh (prefer separate meshes)"
    ],
    "influence_cap_rule": "keep up to 4; cap to 2 only when influences 3+ sum < 0.05; on shoulder/hip blend rows cap to 3 only when influences 4+ sum < 0.05, else keep and report",
    "side_planes": "from the skeleton: torso = median x of unsided core bones; L/R pair = mean x of the two heads"
  },
  "rom_note": "X-axis signs follow each bone bend_test (the builder flips rolls until the tests pass); Y/Z entries carry a \"positive\" text the builder resolves by a displacement test",
