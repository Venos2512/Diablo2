{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp@2.0.0"],
      "env": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true",
        "BLENDER_MCP_DISABLE_TELEMETRY": "true",
        "UV_CACHE_DIR": "E:\\uv-cache"
      }
    }
  }
}
